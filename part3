import java.io.*;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.util.*;
import java.util.stream.Collectors;


class ExceptionHandler {
    public static void handleRuntimeException(String message) {
        System.err.println(" Error: " + message);
    }

    public static void handleFileException(String message, Exception e) {
        System.err.println(" File Error: " + message);
        System.err.println("Details: " + e.getMessage());
    }
}

class Movie {
    private String id;
    private String title;
    private String genre;
    private double rating;
    private LocalDate releaseDate;

    public Movie(String id, String title, String genre, double rating, LocalDate releaseDate) {
        this.id = id;
        this.title = title;
        this.genre = genre;
        this.rating = rating;
        this.releaseDate = releaseDate;
    }

   
    public String getId() { return id; }
    public String getTitle() { return title; }
    public String getGenre() { return genre; }
    public double getRating() { return rating; }
    public LocalDate getReleaseDate() { return releaseDate; }

    @Override
    public String toString() {
        return String.format("ID: %s | Title: %-30s | Genre: %-12s | Rating: %.1f | Release: %s",
                id, title, genre, rating, releaseDate.format(DateTimeFormatter.ISO_LOCAL_DATE));
    }
}


class Watchlist {
    private List<String> movieIds;

    public Watchlist() {
        this.movieIds = new ArrayList<>();
    }

    public Watchlist(List<String> movieIds) {
        this.movieIds = new ArrayList<>(movieIds);
    }

    
    public boolean addMovie(String movieId) {
        if (movieId == null || movieId.trim().isEmpty()) {
            ExceptionHandler.handleRuntimeException("Movie ID cannot be empty");
            return false;
        }
        movieId = movieId.trim();
        if (movieIds.contains(movieId)) {
            ExceptionHandler.handleRuntimeException("The movie is already in the watchlist");
            return false;
        }
        return movieIds.add(movieId);
    }

    
    public boolean removeMovie(String movieId) {
        if (movieId == null || movieId.trim().isEmpty()) {
            ExceptionHandler.handleRuntimeException("Movie ID cannot be empty");
            return false;
        }
        movieId = movieId.trim();
        if (!movieIds.contains(movieId)) {
            ExceptionHandler.handleRuntimeException("The movie is not in the watchlist");
            return false;
        }
        return movieIds.remove(movieId);
    }

    
    public boolean containsMovie(String movieId) {
        if (movieId == null || movieId.trim().isEmpty()) {
            return false;
        }
        return movieIds.contains(movieId.trim());
    }

    
    public List<String> getMovieIds() {
        return new ArrayList<>(movieIds);
    }

    
    public String toCsvString() {
        return movieIds.isEmpty() ? "" : String.join(",", movieIds);
    }
}


class History {
    private List<String> movieIds;

    public History() {
        this.movieIds = new ArrayList<>();
    }

    public History(List<String> movieIds) {
        this.movieIds = new ArrayList<>(movieIds);
    }

    public boolean addWatchedMovie(String movieId) {
        if (movieId == null || movieId.trim().isEmpty()) {
            ExceptionHandler.handleRuntimeException("Movie ID cannot be empty");
            return false;
        }
        movieId = movieId.trim();
        if (movieIds.contains(movieId)) {
            ExceptionHandler.handleRuntimeException("The movie is already in viewing history");
            return false;
        }
        return movieIds.add(movieId);
    }

    
    public List<String> getWatchedMovieIds() {
        return new ArrayList<>(movieIds);
    }

    
    public String toCsvString() {
        return movieIds.isEmpty() ? "" : String.join(",", movieIds);
    }
}


class User {
    private String username;
    private String password;
    private Watchlist watchlist;
    private History history;

    public User(String username, String password) {
        this.username = username;
        this.password = password;
        this.watchlist = new Watchlist();
        this.history = new History();
    }

    public User(String username, String password, List<String> watchlistIds, List<String> historyIds) {
        this.username = username;
        this.password = password;
        this.watchlist = new Watchlist(watchlistIds);
        this.history = new History(historyIds);
    }
    
    public String getUsername() { return username; }
    public String getPassword() { return password; }
    public Watchlist getWatchlist() { return watchlist; }
    public History getHistory() { return history; }

    
    public String toCsvString() {
        return String.format("%s,%s,%s,%s",
                username,
                password,
                watchlist.toCsvString(),
                history.toCsvString());
    }
}


class UserFileHandler {
    private static final String USER_FILE_PATH = "users.csv";

    
    public List<User> readAllUsers() {
        List<User> users = new ArrayList<>();
        File file = new File(USER_FILE_PATH);

        if (!file.exists()) {
            try {
                file.createNewFile();
            } catch (IOException e) {
                ExceptionHandler.handleFileException("Failed to create user file", e);
            }
            return users;
        }

        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (line.isEmpty()) continue;
                String[] parts = line.split(",", 4); 
                if (parts.length < 2) continue;

                String username = parts[0].trim();
                String password = parts[1].trim();
                List<String> watchlistIds = parts.length >= 3 ? Arrays.stream(parts[2].split(","))
                        .map(String::trim)
                        .filter(id -> !id.isEmpty())
                        .collect(Collectors.toList()) : new ArrayList<>();
                List<String> historyIds = parts.length >= 4 ? Arrays.stream(parts[3].split(","))
                        .map(String::trim)
                        .filter(id -> !id.isEmpty())
                        .collect(Collectors.toList()) : new ArrayList<>();

                users.add(new User(username, password, watchlistIds, historyIds));
            }
        } catch (IOException e) {
            ExceptionHandler.handleFileException("Failed to read user file", e);
        }
        return users;
    }

    
    public boolean writeAllUsers(List<User> users) {
        try (BufferedWriter bw = new BufferedWriter(new FileWriter(USER_FILE_PATH))) {
            for (User user : users) {
                bw.write(user.toCsvString());
                bw.newLine();
            }
            return true;
        } catch (IOException e) {
            ExceptionHandler.handleFileException("Failed to write user file", e);
            return false;
        }
    }
}


class UserAuthentication {
    private List<User> users;
    private User currentUser;
    private UserFileHandler userFileHandler;

    public UserAuthentication() {
        this.userFileHandler = new UserFileHandler();
        this.users = userFileHandler.readAllUsers();
        this.currentUser = null;
    }

    
    public boolean login(String username, String password) {
        for (User user : users) {
            if (user.getUsername().equals(username) && user.getPassword().equals(password)) {
                currentUser = user;
                System.out.println(" Login successful! Welcome, " + username + "!");
                return true;
            }
        }
        ExceptionHandler.handleRuntimeException("Invalid username or password");
        return false;
    }

    
    public boolean register(String username, String password) {
        if (users.stream().anyMatch(u -> u.getUsername().equals(username))) {
            ExceptionHandler.handleRuntimeException("Username already exists");
            return false;
        }
        User newUser = new User(username, password);
        users.add(newUser);
        if (userFileHandler.writeAllUsers(users)) {
            System.out.println(" Registration successful! You can now log in.");
            return true;
        }
        return false;
    }

    
    public boolean saveUserChanges() {
        if (currentUser == null) {
            ExceptionHandler.handleRuntimeException("No logged-in user");
            return false;
        }
        return userFileHandler.writeAllUsers(users);
    }

    
    public boolean isLoggedIn() { return currentUser != null; }
    public User getCurrentUser() { return currentUser; }
    public void logout() { currentUser = null; }
}


class MarkWatchedFeature {
    private MovieSystem movieSystem;
    private UserAuthentication userAuth;

    public MarkWatchedFeature(MovieSystem movieSystem, UserAuthentication userAuth) {
        this.movieSystem = movieSystem;
        this.userAuth = userAuth;
    }

    public boolean markAsWatched(String movieId) {
        
        if (!userAuth.isLoggedIn()) {
            ExceptionHandler.handleRuntimeException("Please log in first to mark movies as watched");
            return false;
        }

        movieId = movieId.trim();
        if (!movieSystem.isValidMovieId(movieId)) {
            ExceptionHandler.handleRuntimeException("Invalid movie ID: " + movieId);
            return false;
        }

        User currentUser = userAuth.getCurrentUser();
        Watchlist watchlist = currentUser.getWatchlist();
        History history = currentUser.getHistory();

        
        if (watchlist.containsMovie(movieId)) {
            watchlist.removeMovie(movieId);
            System.out.println(" Movie removed from watchlist: " + movieSystem.getMovieById(movieId).getTitle());
        }

        
        if (history.addWatchedMovie(movieId)) {
            
            if (userAuth.saveUserChanges()) {
                System.out.println(" Successfully marked as watched: " + movieSystem.getMovieById(movieId).getTitle());
                return true;
            } else {
                ExceptionHandler.handleRuntimeException("Failed to save changes to file");
                return false;
            }
        }
        return false;
    }
}


public class MovieSystem {
    private List<Movie> movies;
    private String movieFilePath;
    private Map<String, List<Movie>> genreMap;
    private Scanner scanner;
    private UserAuthentication userAuth;
    private MarkWatchedFeature markWatchedFeature; 

    public MovieSystem() {
        this.movies = new ArrayList<>();
        this.movieFilePath = "movies.csv";
        this.genreMap = new HashMap<>();
        this.scanner = new Scanner(System.in);
        this.userAuth = new UserAuthentication();
        this.markWatchedFeature = new MarkWatchedFeature(this, userAuth); 
        loadMovies();
        buildGenreMap();
    }

    
    private void loadMovies() {
        File file = new File(movieFilePath);
        if (!file.exists()) {
            ExceptionHandler.handleFileException("Movie file not found: " + movieFilePath, new FileNotFoundException());
            return;
        }

        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            String line;
            boolean isFirstLine = true;
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");

            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (isFirstLine) {
                    isFirstLine = false;
                    continue; 
                }
                if (line.isEmpty()) continue;

                String[] parts = line.split(",", 5);
                if (parts.length != 5) {
                    ExceptionHandler.handleRuntimeException("Invalid movie data: " + line);
                    continue;
                }

                try {
                    String id = parts[0].trim();
                    String title = parts[1].trim();
                    String genre = parts[2].trim();
                    double rating = Double.parseDouble(parts[3].trim());
                    LocalDate releaseDate = LocalDate.parse(parts[4].trim(), formatter);

                    movies.add(new Movie(id, title, genre, rating, releaseDate));
                } catch (NumberFormatException e) {
                    ExceptionHandler.handleRuntimeException("Invalid rating in line: " + line);
                } catch (DateTimeParseException e) {
                    ExceptionHandler.handleRuntimeException("Invalid date format in line: " + line);
                }
            }
            System.out.println("Loaded " + movies.size() + " movies successfully!");
        } catch (IOException e) {
            ExceptionHandler.handleFileException("Failed to load movies", e);
        }
    }

   
    private void buildGenreMap() {
        for (Movie movie : movies) {
            String genre = movie.getGenre().toLowerCase();
            genreMap.computeIfAbsent(genre, k -> new ArrayList<>()).add(movie);
        }
    }

    
    public boolean isValidMovieId(String movieId) {
        return movies.stream().anyMatch(m -> m.getId().equals(movieId));
    }

    
    public Movie getMovieById(String movieId) {
        return movies.stream()
                .filter(m -> m.getId().equals(movieId))
                .findFirst()
                .orElse(null);
    }

    
    private void displayAllMovies() {
        System.out.println("\n=== All Movies (" + movies.size() + ") ===");
        movies.forEach(System.out::println);
    }

    
    private void browseMoviesPaginated() {
        final int PAGE_SIZE = 5;
        int totalPages = (int) Math.ceil((double) movies.size() / PAGE_SIZE);
        int currentPage = 1;

        while (true) {
            System.out.println("\n=== Browse Movies (Page " + currentPage + "/" + totalPages + ") ===");
            int start = (currentPage - 1) * PAGE_SIZE;
            int end = Math.min(start + PAGE_SIZE, movies.size());

            for (int i = start; i < end; i++) {
                System.out.println(movies.get(i));
            }

            System.out.println("\nNavigation: [P]revious | [N]ext | [Q]uit");
            System.out.print("Enter choice: ");
            String choice = scanner.nextLine().trim().toUpperCase();

            switch (choice) {
                case "P":
                    if (currentPage > 1) currentPage--;
                    else ExceptionHandler.handleRuntimeException("Already on first page");
                    break;
                case "N":
                    if (currentPage < totalPages) currentPage++;
                    else ExceptionHandler.handleRuntimeException("Already on last page");
                    break;
                case "Q":
                    return;
                default:
                    ExceptionHandler.handleRuntimeException("Invalid choice");
            }
        }
    }

  
    private void displayTopRatedMovies() {
        int limit = 10;
        List<Movie> topRated = movies.stream()
                .sorted((m1, m2) -> Double.compare(m2.getRating(), m1.getRating()))
                .limit(limit)
                .collect(Collectors.toList());

        System.out.println("\n=== Top " + limit + " Rated Movies ===");
        topRated.forEach(System.out::println);
    }

    
    private void displayRecentMovies() {
        LocalDate threeMonthsAgo = LocalDate.now().minusMonths(3);
        List<Movie> recent = movies.stream()
                .filter(m -> m.getReleaseDate().isAfter(threeMonthsAgo))
                .sorted((m1, m2) -> m2.getReleaseDate().compareTo(m1.getReleaseDate()))
                .collect(Collectors.toList());

        System.out.println("\n=== Recent Movies (Last 3 Months) ===");
        if (recent.isEmpty()) {
            System.out.println("No recent movies found.");
        } else {
            recent.forEach(System.out::println);
        }
    }

    
    private void searchMovies() {
        System.out.print("\nEnter search keyword (title/genre): ");
        String keyword = scanner.nextLine().trim().toLowerCase();

        List<Movie> results = movies.stream()
                .filter(m -> m.getTitle().toLowerCase().contains(keyword) ||
                        m.getGenre().toLowerCase().contains(keyword))
                .collect(Collectors.toList());

        System.out.println("\n=== Search Results (" + results.size() + ") ===");
        if (results.isEmpty()) {
            System.out.println("No movies found matching keyword: " + keyword);
        } else {
            results.forEach(System.out::println);
        }
    }

    
    private void browseByGenre() {
        System.out.println("\n=== Available Genres ===");
        genreMap.keySet().forEach(g -> System.out.print(g + " | "));
        System.out.print("\nEnter genre to browse: ");
        String genre = scanner.nextLine().trim().toLowerCase();

        List<Movie> genreMovies = genreMap.get(genre);
        if (genreMovies == null || genreMovies.isEmpty()) {
            ExceptionHandler.handleRuntimeException("No movies found for genre: " + genre);
            return;
        }

        System.out.println("\n=== Movies in Genre: " + genre + " (" + genreMovies.size() + ") ===");
        genreMovies.forEach(System.out::println);
    }

    
    private void displayDatabaseStats() {
        System.out.println("\n=== Database Statistics ===");
        System.out.println("Total Movies: " + movies.size());
        System.out.println("Total Genres: " + genreMap.size());
        System.out.println("Highest Rating: " + movies.stream().mapToDouble(Movie::getRating).max().orElse(0));
        System.out.println("Lowest Rating: " + movies.stream().mapToDouble(Movie::getRating).min().orElse(0));
        System.out.println("Average Rating: " + String.format("%.1f", movies.stream().mapToDouble(Movie::getRating).average().orElse(0)));
    }

    
    private void manageUserWatchlist() {
        if (!userAuth.isLoggedIn()) {
            ExceptionHandler.handleRuntimeException("Please log in first to manage watchlist");
            return;
        }

        User user = userAuth.getCurrentUser();
        Watchlist watchlist = user.getWatchlist();

        while (true) {
            System.out.println("\n=== Manage Watchlist ===");
            System.out.println("1. View Watchlist");
            System.out.println("2. Add Movie to Watchlist");
            System.out.println("3. Remove Movie from Watchlist");
            System.out.println("4. Back to Main Menu");
            System.out.print("Enter choice: ");
            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    
                    List<String> watchlistIds = watchlist.getMovieIds();
                    if (watchlistIds.isEmpty()) {
                        System.out.println("Your watchlist is empty.");
                    } else {
                        System.out.println("=== Your Watchlist (" + watchlistIds.size() + " movies) ===");
                        for (String movieId : watchlistIds) {
                            Movie movie = getMovieById(movieId);
                            if (movie != null) {
                                System.out.printf("ID: %s | Title: %-30s | Genre: %-12s | Rating: %.1f%n",
                                        movieId, movie.getTitle(), movie.getGenre(), movie.getRating());
                            }
                        }
                    }
                    break;

                case "2":
                    
                    System.out.print("Enter movie ID to add: ");
                    String addId = scanner.nextLine().trim();
                    if (isValidMovieId(addId)) {
                        if (watchlist.addMovie(addId)) {
                            userAuth.saveUserChanges();
                            System.out.println( "Movie added to watchlist!");
                        }
                    } else {
                        ExceptionHandler.handleRuntimeException("Invalid movie ID: " + addId);
                    }
                    break;

                case "3":
                    
                    System.out.print("Enter movie ID to remove: ");
                    String removeId = scanner.nextLine().trim();
                    if (watchlist.removeMovie(removeId)) {
                        userAuth.saveUserChanges();
                        System.out.println("Movie removed from watchlist!");
                    }
                    break;

                case "4":
                    return;

                default:
                    ExceptionHandler.handleRuntimeException("Invalid choice");
            }
        }
    }

    
    private void manageUserHistory() {
        if (!userAuth.isLoggedIn()) {
            ExceptionHandler.handleRuntimeException("Please log in first to view history");
            return;
        }

        User user = userAuth.getCurrentUser();
        History history = user.getHistory();

        while (true) {
            System.out.println("\n=== Manage Viewing History ===");
            System.out.println("1. View History");
            System.out.println("2. Back to Main Menu");
            System.out.print("Enter choice: ");
            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    List<String> historyIds = history.getWatchedMovieIds();
                    if (historyIds.isEmpty()) {
                        System.out.println("Your viewing history is empty.");
                    } else {
                        System.out.println("=== Your Viewing History (" + historyIds.size() + " movies) ===");
                        for (String movieId : historyIds) {
                            Movie movie = getMovieById(movieId);
                            if (movie != null) {
                                System.out.printf("ID: %s | Title: %-30s | Genre: %-12s | Rating: %.1f%n",
                                        movieId, movie.getTitle(), movie.getGenre(), movie.getRating());
                            }
                        }
                    }
                    break;

                case "2":
                    return;

                default:
                    ExceptionHandler.handleRuntimeException("Invalid choice");
            }
        }
    }

    
    private void markMovieAsWatched() {
        System.out.println("\n=== Mark Movie as Watched ===");
        System.out.print("Enter movie ID to mark as watched: ");
        String movieId = scanner.nextLine().trim();
        markWatchedFeature.markAsWatched(movieId);
    }

    
    private void displayMainMenu() {
        System.out.println("\n=== MAIN MENU ===");
        System.out.println("1. View All Movies");
        System.out.println("2. Browse Movies (Paginated)");
        System.out.println("3. Top Rated Movies");
        System.out.println("4. Recent Movies");
        System.out.println("5. Search Movies");
        System.out.println("6. Browse by Genre");
        System.out.println("7. Database Statistics");
        System.out.println("8. Manage Watchlist");
        System.out.println("9. Manage Viewing History");
        System.out.println("10. Mark Movie as Watched"); 
        System.out.println("0. Exit");
        System.out.print("Enter your choice: ");
    }

    
    private boolean displayAuthMenu() {
        System.out.println("=== Movie System Authentication ===");
        System.out.println("1. Login");
        System.out.println("2. Register");
        System.out.println("0. Exit");
        System.out.print("Enter your choice: ");
        String choice = scanner.nextLine().trim();

        switch (choice) {
            case "1":
                System.out.print("Enter username: ");
                String username = scanner.nextLine().trim();
                System.out.print("Enter password: ");
                String password = scanner.nextLine().trim();
                return userAuth.login(username, password);

            case "2":
                System.out.print("Enter username: ");
                String newUser = scanner.nextLine().trim();
                System.out.print("Enter password: ");
                String newPass = scanner.nextLine().trim();
                userAuth.register(newUser, newPass);
                return false; 

            case "0":
                System.out.println("Goodbye!");
                return false;

            default:
                ExceptionHandler.handleRuntimeException("Invalid choice");
                return false;
        }
    }
    
    public void startMainSystem() {
        System.out.println("Welcome to Movie System!");
        
        while (!userAuth.isLoggedIn()) {
            if (!displayAuthMenu()) {
                scanner.close();
                return;
            }
        }
        
        while (true) {
            displayMainMenu();
            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    displayAllMovies();
                    break;
                case "2":
                    browseMoviesPaginated();
                    break;
                case "3":
                    displayTopRatedMovies();
                    break;
                case "4":
                    displayRecentMovies();
                    break;
                case "5":
                    searchMovies();
                    break;
                case "6":
                    browseByGenre();
                    break;
                case "7":
                    displayDatabaseStats();
                    break;
                case "8":
                    manageUserWatchlist();
                    break;
                case "9":
                    manageUserHistory();
                    break;
                case "10":
                    markMovieAsWatched();
                    break;
                case "0":
                    System.out.println("Goodbye!");
                    scanner.close();
                    return;
                default:
                    ExceptionHandler.handleRuntimeException("Invalid choice. Please try again.");
            }
        }
    }

    
    public static void main(String[] args) {
        MovieSystem system = new MovieSystem();
        system.startMainSystem();
    }
}
